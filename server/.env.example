PORT=5000
NODE_ENV=development
MONGODB_URI=your-mongodb-connection-string
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password-or-app-password
SMTP_FROM=your-email@example.com
SMTP_SECURE=false
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_FROM_NAME=FitSaarthi
MSG91_EMAIL_FROM=no-reply@your-verified-domain.example
MSG91_EMAIL_DOMAIN=your-verified-domain.example
MSG91_EMAIL_TEMPLATE_ID=global_otp
MSG91_TEMPLATE_ENROLLMENT=your-enrollment-template-id
# Centralized automation templates. Configure the matching MSG91 variables before enabling each event.
MSG91_TEMPLATE_ENQUIRY=enquiry_4
MSG91_TEMPLATE_ENQUIRY_FOLLOWUP=enquiry_followup_2
MSG91_TEMPLATE_WELCOME=welcom_gym
MSG91_TEMPLATE_EXPIRY_7_DAYS=membership_expire_7day
MSG91_TEMPLATE_EXPIRY_3_DAYS=membership_expire_3day
MSG91_TEMPLATE_EXPIRY_TODAY=membership_expire_today
MSG91_TEMPLATE_PAYMENT_RECEIPT=payment_recieved_3
MSG91_TEMPLATE_MEMBERSHIP_RENEWED=membership_renew
EMAIL_TIMEZONE=Asia/Kolkata
# Templates used by the Members > Send message bulk composer. The email template needs
# member_name and message variables; SMS and WhatsApp templates need the message variable.
# Keep credential values only in .env.
MSG91_MEMBER_EMAIL_TEMPLATE_ID=your-member-email-template-id
MSG91_MEMBER_SMS_TEMPLATE_ID=your-member-sms-template-id
MSG91_WHATSAPP_INTEGRATED_NUMBER=919999999999
MSG91_MEMBER_WHATSAPP_TEMPLATE_NAME=your_member_template_name
MSG91_MEMBER_WHATSAPP_LANGUAGE=en
